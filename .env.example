# Optional. When unset, the hub uses the local demo file store at .data/hub.json
# and auto-seeds on first page load.
DATABASE_URL="postgresql://lendz:lendz@localhost:5432/lendz_hub?schema=public"

# Shared secret for POST /api/ingest/events (x-ingest-secret or Bearer token).
# When unset, ingest is open for local development.
INGEST_SHARED_SECRET="dev-ingest-secret"
